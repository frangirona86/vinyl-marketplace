# Docker environment variables for backend
# Copy this to ../backend/.env when using Docker

APP_NAME="Vinyl Marketplace"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

# Database (Docker)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=vinyl_db
DB_USERNAME=vinyl_user
DB_PASSWORD=vinyl_pass

# Cache & Session (Redis)
CACHE_DRIVER=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Redis (Docker)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Queue
QUEUE_CONNECTION=redis

# Discogs API
DISCOGS_CONSUMER_KEY=your_key_here
DISCOGS_CONSUMER_SECRET=your_secret_here
DISCOGS_USER_AGENT=VinylMarketplace/1.0

# OpenAI
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o-mini

# YouTube
YOUTUBE_API_KEY=your_key_here
